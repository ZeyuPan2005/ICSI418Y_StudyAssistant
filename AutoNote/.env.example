# Template only: keep real credentials in the process environment or an ignored .env.
# The imported modules do not all call load_dotenv(); copying this file alone is insufficient.
# Zhipu/GLM callers with previously embedded credentials:
ZHIPU_API_KEY=replace-with-your-zhipu-api-key
# note_Wu_v2.py uses LangChain's default OPENAI_API_KEY with the Zhipu base URL.
# Supply a Zhipu credential here, not a credential for another provider.
OPENAI_API_KEY=replace-with-your-zhipu-api-key
# transcriber_Wang.py:
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
